{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "west configure",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "app gdbserver",
                "powershell",
                "-NoExit",
                "-Command",
                ". 'E:/zephyr/.venv/Scripts/Activate.ps1'"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "build app",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject;west build -d ./build_app",
        },
        {
            "type": "shell",
            "label": "build bootloader",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject;west build -d ./build_boot",
        },
        {
            "type": "shell",
            "label": "flash app",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject;west flash -d ./build_app",
        },
        {
            "type": "shell",
            "label": "flash bootloader",
            "command": "E:/zephyr/.venv/Scripts/Activate.ps1;cd E:/zephyr/zephyrproject;west flash -d ./build_boot",
        },
        {
            "type": "process",
            "label": "start gdbserver with reset bootloader",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                //todo freq 수정 or 옵션 제외
                //west debugserver는 stlink_gdbserver에 상세 옵션(--frequency --shared를 넘길 수 없음) 따라서 직접 띄우도록 하자
                "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.EXE --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --halt --swd --initialize-reset --shared --frequency 200"
            ],
            "dependsOn": [
                "build bootloader"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver no reset bootloader",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                //todo freq 수정 or 옵션 제외
                //west debugserver는 stlink_gdbserver에 상세 옵션(--frequency --shared를 넘길 수 없음) 따라서 직접 띄우도록 하자, attach 하려면 어쩔 수 없이 강재로 써야함
                "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.EXE --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --swd -g --shared --frequency 200"
            ],
            "dependsOn": [
                "build bootloader"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver with reset app",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                //todo freq 수정 or 옵션 제외
                //west debugserver는 stlink_gdbserver에 상세 옵션(--frequency --shared를 넘길 수 없음) 따라서 직접 띄우도록 하자
                "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.EXE --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --halt --swd --initialize-reset --shared --frequency 200"
            ],
            "dependsOn": [
                "build app"
            ],
            "problemMatcher": []
        },
        {
            "type": "process",
            "label": "start gdbserver no reset app",
            "command": "cmd",
            "args": [
                "/d",
                "/c",
                "start",
                "boot gdbserver",
                "powershell",
                "-Command",
                //todo freq 수정 or 옵션 제외
                //west debugserver는 stlink_gdbserver에 상세 옵션(--frequency --shared를 넘길 수 없음) 따라서 직접 띄우도록 하자, attach 하려면 어쩔 수 없이 강재로 써야함
                "C:/ST/STM32CubeCLT_1.22.0/STLink-gdb-server/bin/ST-LINK_gdbserver.EXE --stm32cubeprogrammer-path 'C:/ST/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin' --port-number 61234 --apid 0 --swd -g --shared --frequency 200"
            ],
            "dependsOn": [
                "build app"
            ],
            "problemMatcher": []
        }
    ]
}